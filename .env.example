# Copy to .env and adjust if needed. No secrets are required for the MVP.
# SQLite database location (defaults to <repo>/stockpilot.db).
STOCKPILOT_DB_PATH=stockpilot.db
# Browser origins allowed to call the API (frontend dev server).
CORS_ORIGINS=http://localhost:5173

# ---- AI metadata generation (optional) ----
# Server-side Cohere API key (https://dashboard.cohere.com/api-keys).
# Leave empty to disable AI generation; manual metadata entry always works.
# The key is never sent to the browser or committed to git (.env is ignored).
COHERE_API_KEY=
# Vision model used for image analysis. Default: command-a-vision-07-2025
# (Cohere's first multimodal model; see docs.cohere.com/docs/image-inputs).
STOCKPILOT_AI_MODEL=command-a-vision-07-2025
# Timeout in seconds for a single Cohere analysis request.
STOCKPILOT_AI_TIMEOUT=60

# ---- Upload storage (optional) ----
# Directory for uploaded images (defaults to <repo>/uploads, gitignored).
STOCKPILOT_UPLOAD_DIR=uploads
# Upload size limit in bytes (default 10 MiB).
STOCKPILOT_MAX_UPLOAD_BYTES=10485760

